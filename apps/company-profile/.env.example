# URL publik situs (metadata/OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Database SQLite untuk pesan formulir kontak (ganti adapter & provider untuk MySQL/PostgreSQL — lihat docs/CARA-MODIF.md)
DATABASE_URL=file:./dev.db

# Admin /admin/pesan. HANYA UNTUK DEVELOPMENT — wajib diganti di produksi.
# Bila salah satu kosong, login admin dinonaktifkan (fail closed).
ADMIN_PASSWORD=ganti-saya-dev-saja
# Rahasia penanda-tangan cookie sesi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=dev-only-secret-ganti-di-produksi-min-32-karakter

# Notifikasi email untuk pesan kontak (OPSIONAL). Bila SMTP_HOST atau MAIL_TO kosong, email dinonaktifkan:
# pesan tetap tersimpan di database dan terlihat di /admin/pesan.
# SMTP_HOST=smtp.contoh.id
# SMTP_PORT=587
# SMTP_SECURE=false        # true untuk port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_TO=admin@perusahaan-anda.id
# MAIL_FROM=website@perusahaan-anda.id

# Jumlah reverse proxy tepercaya di depan app (untuk rate limit per IP). Default 1.
# TRUSTED_PROXIES=1
