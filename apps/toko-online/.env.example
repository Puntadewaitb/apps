# URL publik situs (metadata/OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Database SQLite (ganti adapter & provider untuk MySQL/PostgreSQL — lihat docs/CARA-MODIF.md)
DATABASE_URL=file:./dev.db

# Akun dashboard dibuat oleh `npm run setup` (prisma/seed.ts) HANYA bila password diisi (min. 12 karakter).
# Login dashboard diaktifkan di langkah T6.
ADMIN_EMAIL=admin@toko.example
ADMIN_PASSWORD=
STAFF_PASSWORD=

# Rahasia sesi login (min. 32 karakter acak). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3005

# Jumlah reverse proxy tepercaya (untuk IP klien di rate limit)
TRUSTED_PROXIES=1

# Folder unggahan (bawaan ./uploads; di luar public/)
# UPLOAD_DIR=./uploads
