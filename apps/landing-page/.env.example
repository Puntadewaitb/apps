# URL publik situs (dipakai untuk metadata/OG & sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Database SQLite (ganti adapter & provider untuk MySQL/PostgreSQL — lihat docs/CARA-MODIF.md)
DATABASE_URL=file:./dev.db

# Admin /admin/leads. HANYA UNTUK DEVELOPMENT — wajib diganti di produksi.
# Bila salah satu kosong, login admin dinonaktifkan (fail closed).
ADMIN_PASSWORD=ganti-saya-dev-saja
# Rahasia penanda-tangan cookie sesi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=dev-only-secret-ganti-di-produksi-min-32-karakter


# Tema: netral | hangat | hijau (menimpa default di content/site.ts)
# NEXT_PUBLIC_THEME=netral

# Tracking opsional — aktif HANYA bila diisi (CSP otomatis melebar untuk host terkait).
# NEXT_PUBLIC_* dibaca saat BUILD: ubah lalu build ulang.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
