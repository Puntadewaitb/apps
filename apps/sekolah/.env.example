# URL publik situs (metadata/OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Database SQLite (ganti adapter & provider untuk MySQL/PostgreSQL — lihat docs/CARA-MODIF.md)
DATABASE_URL=file:./dev.db

# Akun admin pertama dibuat oleh `npm run setup` (prisma/seed.ts) HANYA bila ADMIN_PASSWORD diisi.
# Ganti dengan password kuat (min. 12 karakter). EDITOR_PASSWORD (opsional) membuat akun editor@sekolah.example.
ADMIN_EMAIL=admin@sekolah.example
ADMIN_PASSWORD=
EDITOR_PASSWORD=

# Rahasia sesi login (min. 32 karakter acak). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3004

# Jumlah reverse proxy tepercaya (untuk IP klien di rate limit login)
TRUSTED_PROXIES=1
